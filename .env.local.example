# Copy to .env.local (git-ignored) and fill in real values to run the post-signin suite locally.
JOURNEY_TEST_USER_EMAIL=
JOURNEY_TEST_USER_PASSWORD=

# The B28 team-request journeys (test/specs/post-signin/team-request/) only run
# when this is set: the slug of a team the test user belongs to, in an
# environment you can request models in. Leave it empty to skip them.
JOURNEY_TEST_TEAM_SLUG=

# Set to true only when the backend runs TENANT_ORCHESTRATOR=mock (as compose.yml
# does). It switches on the checks-failed and deploy-failed journeys, which force
# a failure with a marker in the request's purpose that only the mock honours.
JOURNEY_TEST_MOCK_ORCHESTRATOR=false

# Optional. Each journey needs models the team does not already have, so a
# second run needs a fresh team or fresh data. Defaults are in
# test/support/journey-data.js.
# JOURNEY_TEST_MULTI_MODEL_SLUGS=gpt-5-nano,gpt-5-nano-2,gpt-5-mini
# JOURNEY_TEST_PROGRESS_MODEL_SLUG=gpt-4o
# JOURNEY_TEST_NO_SCRIPT_MODEL_SLUG=gpt-4o-2
# JOURNEY_TEST_FAILURE_MODEL_SLUG=gpt-5-3-codex
# JOURNEY_TEST_DEPLOY_TIMEOUT_MS=120000
